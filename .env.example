# Copiar este archivo como .env (no versionado, ya está en .gitignore) y
# completar con los valores reales del entorno local.

# Nombre del servidor SQL Server. Instancia default: localhost.
# Instancia nombrada (ej. Express): localhost\SQLEXPRESS
SQL_SERVER=localhost

# Base de datos Gold del proyecto.
SQL_DATABASE=GoldFiscal

# Driver ODBC instalado en la máquina (verificar con Get-OdbcDriver en PowerShell).
SQL_DRIVER=ODBC Driver 18 for SQL Server

# yes = autenticación de Windows (usuario actual, sin credenciales).
# no = login SQL Server; en ese caso agregar también SQL_UID y SQL_PWD.
SQL_TRUSTED_CONNECTION=yes
